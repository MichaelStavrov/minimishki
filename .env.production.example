# Файл для первого production-развёртывания. Скопируйте его в .env.production
# на VPS, заполните значения и никогда не добавляйте созданный файл в Git.

# PostgreSQL живёт только во внутренней Docker-сети.
POSTGRES_DB=minimishki
POSTGRES_USER=minimishki
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://minimishki:CHANGE_ME@postgres:5432/minimishki?schema=public

# Nest.js
NODE_ENV=production
PORT=3001
WEB_ORIGIN=https://minimishki.ru
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Публичный API-адрес встраивается в браузерную сборку Next.js.
NEXT_PUBLIC_API_URL=https://api.minimishki.ru/api
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Caddy передаст этот адрес Let’s Encrypt для уведомлений о сертификате.
ACME_EMAIL=

# Уведомления обязательны для запуска API в production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

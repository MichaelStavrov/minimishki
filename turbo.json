{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "API_URL", "NEXT_PUBLIC_API_URL", "JWT_SECRET", "WEB_ORIGIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {}
  }
}

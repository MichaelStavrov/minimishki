# ---------------------------------------------------------------------------
# Шаблон переменных окружения для apps/web (Next.js).
# Реальные значения — в apps/web/.env.local (в git не попадает).
#   cp apps/web/.env.example apps/web/.env.local
# ---------------------------------------------------------------------------

# Серверный адрес Nest API. Используется только Server Components и другим
# серверным кодом Next.js; в браузерный бандл не встраивается.
API_URL=http://localhost:3001/api

# Публичный адрес Nest API для запросов из браузера.
# Префикс NEXT_PUBLIC_ встраивает значение в клиентский бандл во время next build,
# поэтому эта переменная не должна содержать секреты.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

// Клиент Prisma — генерируется в node_modules/@prisma/client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Перечисления
// ============================================================

enum Role {
  ADMIN   // полный доступ
  MANAGER // работа с заявками и контентом
  USER    // обычный пользователь
}

enum LeadStatus {
  NEW         // новая заявка
  IN_PROGRESS // менеджер связался
  CONFIRMED   // запись подтверждена
  REJECTED    // отказ
}

enum PriceType {
  FIXED      // фиксированная цена
  FROM       // цена «от»
  FREE       // бесплатно
  INCLUDED   // входит в стоимость
  ON_REQUEST // рассчитывается индивидуально
}

enum ScheduleType {
  RECURRING  // регулярное расписание
  ON_REQUEST // время определяется по согласованию
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AgeMode {
  INHERIT // использовать возраст услуги
  CUSTOM  // использовать собственный диапазон
  NONE    // возрастных ограничений нет
}

// ============================================================
// Пользователи
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // хеш argon2, никогда не отдаётся клиенту
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

// ============================================================
// Услуги
// ============================================================

/// Публичная страница услуги детского центра
model Service {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  summary        String?
  contentHtml    String
  ageFromMonths  Int?
  ageToMonths    Int?
  ageNote        String?
  coverUrl       String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean   @default(false)
  archivedAt     DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  offerGroups ServiceOfferGroup[]
  schedules   ServiceSchedule[]
  teachers    Teacher[]
  gallery     GalleryItem[]
  leads       Lead[]

  @@index([isPublished, archivedAt, sortOrder])
}

/// Группа предложений внутри услуги: например, «Абонементы» или «Мастер-классы»
model ServiceOfferGroup {
  id              String   @id @default(cuid())
  serviceId       String
  title           String
  descriptionHtml String?
  isPublished     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  offers  ServiceOffer[]

  @@index([serviceId, isPublished, sortOrder])
}

/// Конкретный тариф, программа или вариант услуги
model ServiceOffer {
  id              String    @id @default(cuid())
  groupId         String
  title           String
  descriptionHtml String?
  imageUrl        String?
  priceType       PriceType
  amount          Int?
  priceUnit       String?
  priceNote       String?
  durationMinutes Int?
  ageMode         AgeMode   @default(INHERIT)
  ageFromMonths   Int?
  ageToMonths     Int?
  ageNote         String?
  isPublished     Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group ServiceOfferGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, isPublished, sortOrder])
}

/// Вариант регулярного расписания либо запись «по согласованию»
model ServiceSchedule {
  id           String       @id @default(cuid())
  serviceId    String
  scheduleType ScheduleType
  daysOfWeek   DayOfWeek[]  @default([])
  startTime    String?
  endTime      String?
  validFrom    DateTime?    @db.Date
  validUntil   DateTime?    @db.Date
  label        String?
  isPublished  Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isPublished, sortOrder])
}

// ============================================================
// Остальной контент сайта
// ============================================================

/// Педагог детского центра
model Teacher {
  id          String    @id @default(cuid())
  slug        String    @unique
  fullName    String
  position    String
  bio         String?
  photoUrl    String?
  isPublished Boolean   @default(false)
  archivedAt  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]

  @@index([isPublished, archivedAt, sortOrder])
}

/// Новость или анонс центра
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gallery GalleryItem[]

  @@index([isPublished, publishedAt])
}

/// Фотография новости, услуги либо общей галереи
model GalleryItem {
  id          String   @id @default(cuid())
  url         String
  alt         String?
  caption     String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([postId, isPublished, sortOrder])
  @@index([serviceId, isPublished, sortOrder])
  @@index([isPublished, sortOrder])
}

// ============================================================
// Заявки
// ============================================================

/// Заявка с публичной формы сайта
model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  childName String?
  childAge  Int?
  comment   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([serviceId])
}

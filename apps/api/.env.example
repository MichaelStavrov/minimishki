# ---------------------------------------------------------------------------
# Шаблон переменных окружения для apps/api.
# Реальные значения — в apps/api/.env (в git не попадает).
#   cp apps/api/.env.example apps/api/.env
# ---------------------------------------------------------------------------

# Строка подключения к PostgreSQL. Разбор по частям:
#   postgresql://          — драйвер, по нему Prisma понимает тип БД
#   postgres:postgres@     — пользователь:пароль (POSTGRES_USER/PASSWORD из compose)
#   localhost:5432         — хост и порт, проброшенные наружу контейнера
#   /minimishki            — имя базы (POSTGRES_DB из compose)
#   ?schema=public         — схема внутри базы; у Postgres по умолчанию public
# Контейнер должен быть запущен: docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minimishki?schema=public"

# Секрет для подписи JWT. Обязательно своё значение, сгенерировать командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Срок жизни токена: 30d — тридцать дней. Понимает форматы 60s, 15m, 12h, 30d.
JWT_EXPIRES_IN="30d"

# Учётные данные администратора, создаваемого командой pnpm db:seed.
# Значения ниже предназначены только для development/test.
# В production demo-seed запрещён; первый администратор будет создаваться
# отдельным production-bootstrap без вымышленных данных.
SEED_ADMIN_EMAIL="admin@minimishki.ru"
SEED_ADMIN_PASSWORD="minimishki-dev-admin"

# Origin frontend-приложения, которому разрешены браузерные CORS-запросы к API.
# Указывается без пути и завершающего слеша: протокол + хост + необязательный порт.
WEB_ORIGIN="http://localhost:3000"

# Порт HTTP-сервера Nest. 3000 занят фронтендом Next.js, поэтому 3001.
PORT=3001

# development | production | test. Влияет на подробность логов и стек-трейсов.
NODE_ENV=development

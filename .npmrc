# Не падать при конфликте peer-зависимостей (React 19 / Nest 11 регулярно конфликтуют)
strict-peer-dependencies=false

# Автоматически доустанавливать недостающие peer-зависимости
auto-install-peers=true

# Точные версии в package.json при pnpm add (без ^)
save-exact=false

# Использовать один общий store — экономия места на диске
prefer-workspace-packages=true
link-workspace-packages=true
